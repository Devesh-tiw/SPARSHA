GEMINI_API_KEY=replace_with_google_ai_studio_key
GEMINI_MODEL=gemini-3.6-flash
CHROMA_PERSIST_PATH=./ayurveda_vector_db
CHROMA_COLLECTION=sparsha_collection
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Speed/accuracy controls
RETRIEVAL_POOL=40
MAX_CLASSIFY_CANDIDATES=5
CLASSIFY_CONCURRENCY=5
# true returns the verified schema record directly (fastest and least hallucinatory).
DETERMINISTIC_OUTPUT=true
RETRIEVAL_MAX_DISTANCE=1.0
RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW_SECONDS=60
GEMINI_RATE_LIMIT_CALLS=12
